{
  "id": "lawyers-us",
  "name": "US Lawyers - Service Gap Engine",
  "vertical": "legal",
  "description": "ZIP-managed US law-firm discovery for service-page gap validation and direct-owner-email outreach.",
  "market_plan": "market_plans/lawyers-us-zips.json",
  "working_set": {
    "target_net_new_domains_per_run": 1000,
    "historical_seed_expected_domains": 1000,
    "dedupe_scope": "global_business",
    "status_after_discovery": "Ready for Crawl Evidence",
    "qualified_after_discovery": false
  },
  "google": {
    "engine": "places_v7_pro_grounding_enterprise_fallback",
    "included_type": "lawyer",
    "strict_type_filtering": true,
    "region_code": "US",
    "language_code": "en",
    "query_template": "lawyer in {zip_code}",
    "pro_field_mask": [
      "places.id",
      "places.displayName",
      "places.formattedAddress",
      "places.businessStatus",
      "nextPageToken"
    ],
    "enterprise_fallback_field_mask": [
      "places.id",
      "places.displayName",
      "places.formattedAddress",
      "places.businessStatus",
      "places.websiteUri",
      "nextPageToken"
    ],
    "min_rating_search_filter": 4.0,
    "page_size": 20,
    "max_pages_per_zip": 3,
    "paginate_if_first_page_raw_count_at_least": 20,
    "zip_location_restriction_half_span_km": 10.0,
    "exact_postal_code_required": false,
    "zip_is_coverage_seed_not_address_gate": true,
    "use_grounding_lite": true,
    "use_open_web_resolver": false,
    "use_place_details_enterprise": false,
    "use_review_text": false,
    "zero_paid_mode": true,
    "monthly_text_search_pro_request_budget": 4800,
    "monthly_grounding_lite_request_budget": 9500,
    "monthly_enterprise_request_budget": 900,
    "grounding_requires_same_place_id": true,
    "enterprise_fallback_when_grounding_budget_exhausted": true,
    "enterprise_fallback_when_grounding_unresolved": true
  },
  "quality": {
    "allowed_business_statuses": ["OPERATIONAL"],
    "min_rating": 4.0,
    "minimum_review_count_gate_enabled": false,
    "require_resolved_official_domain": true,
    "dedupe_by_place_id": true,
    "dedupe_by_domain": true
  },
  "crawl": {
    "engine": "crawl4ai",
    "stage": "post_discovery_evidence_enrichment",
    "input_status": "Ready for Crawl Evidence",
    "output_status": "Ready for Validation",
    "mode": "homepage_links_only",
    "same_domain_only": true,
    "follow_links": false,
    "classification": false,
    "default_workers": 4,
    "run_inside_discovery": false
  },
  "qualification": {
    "gap_double_check_required": true,
    "decision_maker_required": true,
    "direct_public_owner_email_required": true,
    "generic_email_allowed": false,
    "final_status": "Qualified"
  },
  "outreach": {
    "global_suppression_after_contact": true,
    "allow_reengage_only_when_explicitly_scheduled": true
  },
  "compliance": {
    "google_places_non_id_fields_are_transient": true,
    "persist_place_id": true,
    "persist_google_rating_or_review_count": false,
    "persist_google_website_uri": false,
    "enterprise_website_uri_is_transient_fallback_seed": true,
    "terms_review_required_before_production_outreach": true
  }
}
